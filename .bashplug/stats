#.bashplug/stats

function general_stats()
{
  local do_system="yes"
  local do_login="no"
  local do_uptime="yes"

  # ---------------------------------------------------------------------------
  if [ "$do_system" == "yes" ]
  then
    prnt_head "machine"
    num_pkg_upg=$(pacman -Qu | wc -l)
    local entrophy=`cat /proc/sys/kernel/random/entropy_avail`
    prnt_info "at least packages $num_pkg_upg need to be upgraded"
    prnt_info "current entrophy : $entrophy"
    df -hT # | grep --color=never -E -v "tmpfs|devtmpfs|rootfs|overlay"
    #prnt_info "memory usage" 
    free -h
    prnt_info "-------------------------------------------------------------------------------"
  fi

  # ---------------------------------------------------------------------------
  if [ "$do_login" == "yes" ]
  then
    prnt_head "login data"
    prnt_gray
    eval last --dns --since -20days
  fi

  # ---------------------------------------------------------------------------
  if [ "$do_uptime" == "yes" ]
  then
    prnt_head "uptime"
    prnt_gray; uptime
  fi

  # ---------------------------------------------------------------------------
  prnt_gray "process list:"
  prnt_info "disabled -- use ps filters"
  # ps -ef | egrep -o '(UID.*PID.*))|(.*(chrom|firefox)[a-zA-z]*[ ])'

}

general_stats


